@@ -284,12 +284,30 @@ class BlockPool:
                 block_hash, kv_cache_group_id
             )
             if blk.block_hash is not None:
-                # The only valid case where a "new full block" already has a
-                # hash is partial->full promotion of the same cache block.
-                assert (
+                # Expected case: partial->full promotion — the block carries
+                # a partial publication with a token count strictly below
+                # the full hash's. An aligned landing/checkpoint publication
+                # instead registers the chain hash AT the full token count;
+                # that entry is exactly the one this pass would insert, so
+                # promotion is a no-op (crash observed once in ~20 h when
+                # such a block re-entered the caching window). Anything else
+                # is stale metadata: retract and re-register, never fatal.
+                if (
+                    blk.block_hash_num_tokens == num_hash_tokens
+                    and blk.block_hash == block_hash_with_group_id
+                ):
+                    continue
+                if not (
                     blk.block_hash_num_tokens is not None
                     and blk.block_hash_num_tokens < num_hash_tokens
-                )
+                ):
+                    logger.warning(
+                        "[hash-promote] unexpected metadata blk=%s "
+                        "num_tokens=%s full_tokens=%s — re-registering",
+                        blk.block_id,
+                        blk.block_hash_num_tokens,
+                        num_hash_tokens,
+                    )
                 removed_hashes = self._remove_cached_block_hashes(blk)
                 self._emit_block_removed_events(removed_hashes)
             self._insert_block_hash(
