+    def _try_extract_name(self, idx: int) -> str | None:
+        raw = self._tool_slots[idx].args
+        if not raw.lstrip().startswith("{"):
+            return super()._try_extract_name(idx)
+        # JSON body: the base regex could match a "name" field nested
+        # inside a leading "arguments"/"parameters" object (tools with a
+        # literal name argument), so only trust it ahead of those keys;
+        # the complete body parses exactly (upstream #67164).
+        try:
+            parsed = json.loads(raw.strip())
+        except json.JSONDecodeError:
+            parsed = None
