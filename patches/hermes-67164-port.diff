+def _qwen3_json_body_args(raw_args: str, partial: bool) -> str | None:
+    """Arguments JSON from a hermes-style JSON tool body, if the body is one.
+
+    Qwen3 base models (and finetunes drifted off the trained format) emit
+    ``{"name": ..., "arguments": ...}`` directly inside ``<tool_call>``
+    instead of the XML parameter form. Returns None when the body is not
+    JSON, so the caller falls back to XML parameter parsing. An incomplete
+    JSON body during streaming yields "", deferring the arguments to the
+    tool-call close (upstream #67164 semantics).
+    """
+    stripped = raw_args.strip()
+    if not stripped.startswith("{"):
+        return None
+    if partial and not stripped.endswith("}"):
+        # Incomplete JSON: defer without reparsing the growing body.
+        return ""
+    try:
+        parsed = json.loads(stripped)
+    except json.JSONDecodeError:
+        return "" if partial else None
+    if not isinstance(parsed, dict):
+        return "" if partial else None
+    args = parsed.get("arguments", parsed.get("parameters"))
+    if args is None:
+        args = {k: v for k, v in parsed.items() if k != "name"}
+    if isinstance(args, str):
+        return args
+    return json.dumps(args, ensure_ascii=False)
+
+
 def _qwen3_arg_converter(raw_args: str, partial: bool) -> str:
+    json_args = _qwen3_json_body_args(raw_args, partial)
+    if json_args is not None:
+        return json_args
