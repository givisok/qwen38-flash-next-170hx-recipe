@@ -510,6 +541,34 @@ class StreamingParserEngine:
             ]
         return []
 
+    def _fence_track(self, text: str) -> None:
+        """Toggle the code-fence flag on completed ``` runs.
+
+        Each maximal backtick run of 3+ toggles once per 3 backticks. An
+        unterminated trailing run carries into the next chunk, so a fence
+        split across streaming chunks still toggles exactly once.
+        """
+        buf = "`" * self._fence_carry + text
+        self._fence_carry = 0
+        toggles = 0
+        pos = 0
+        n = len(buf)
+        while pos < n:
+            if buf[pos] != "`":
+                pos += 1
+                continue
+            j = pos
+            while j < n and buf[j] == "`":
+                j += 1
+            if j == n:
+                # The run touches the end: it may continue in the next chunk.
+                self._fence_carry = j - pos
+                break
+            toggles += (j - pos) // 3
+            pos = j
+        if toggles % 2:
+            self._in_code_fence = not self._in_code_fence
+
     def _on_content(self, text: str, token_count: int = 0) -> list[SemanticEvent]:
         if not text:
             return []
