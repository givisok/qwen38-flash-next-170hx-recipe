-        return tuple(sorted({max(resend - block, 0), max(extension - block, 0)}))
+        boundaries = {max(resend - block, 0), max(extension - block, 0)}
+        # Fine-grained replay landings (prefix-match unit): lookups on
+        # fine-grained groups drop one HASH unit below the (prompt_len - 1)
+        # cap, not one whole scheduler block. With only the coarse boundaries
+        # the retained state sits far below where replays actually land
+        # (measured: 5184 retained vs 8208 landed on an 8231-token prompt),
+        # so the first replay re-prefills thousands of cached tokens
+        # (port of upstream vllm-project/vllm#52244).
+        unit = min(self.block_pool.hash_block_size, block)
+        if unit < block:
+            boundaries |= {
+                max((request.num_prompt_tokens - 1 - unit) // unit * unit, 0),
+                max(request.num_prompt_tokens // unit * unit - unit, 0),
+            }
+        return tuple(sorted(boundaries))
 
