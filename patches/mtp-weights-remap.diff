+        # drop q_scale (input scales are never cached; no buffer exists).
+        if name.endswith(".self_attn.q_scale"):
+            return None
+        for _s in ("k_scale", "v_scale"):
+            if name.endswith(f".self_attn.{_s}") or name.endswith(
