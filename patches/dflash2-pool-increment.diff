+class _NonCacheableSlidingWindowSpec(SlidingWindowSpec):
+    """Prefix-cache opt-out for a SWA DRAFTER group (VLLM_SWA_NO_PREFIX_CACHE=1).
+
+    A drafter's SWA group forces `partial_hash_hits_enabled` off (its manager
+    lacks fine-grained lookups), which drops the WHOLE engine to block-aligned
+    prefix hits. Block-aligned mamba lookups cannot see the partial/checkpoint
+    state hashes align-mode GDN actually exports, so every first resend of a
+    prompt misses mamba entirely and re-prefills from scratch. Opting the
+    drafter group out of prefix caching (its window KV is trivially recomputed
+    on the resumed tail) keeps fine-grained hits enabled for the target.
+    """
+
+    @property
+    def prefix_cacheable(self) -> bool:
+        return False
